# Copy to .env.local for development. See SETUP.md for how to obtain each value.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard. Supabase may label these
# "publishable key" / "secret key" instead of "anon key" / "service_role key"
# depending on when your project was created — functionally identical here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (contact form email) ────────────────────────────────────────────
RESEND_API_KEY=
# No custom domain verified yet -> use Resend's shared sandbox sender. Swap to
# e.g. "Arun Veerappan <hello@yourdomain.com>" once you verify a domain in Resend.
RESEND_FROM_EMAIL=onboarding@resend.dev
# Where "new enquiry" notification emails are sent. This is an operational
# setting, not public site content — change it freely.
ADMIN_NOTIFICATION_EMAIL=arunveerappan10@gmail.com

# ── Cloudflare Turnstile (contact form spam protection) ───────────────────
# Cloudflare's published always-pass *test* keys — safe for local dev before
# you register a real site at https://dash.cloudflare.com/?to=/:account/turnstile
# Verify current values at https://developers.cloudflare.com/turnstile/troubleshooting/testing/
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Random string that salts IP addresses before hashing (rate limiting +
# enquiries.ip_hash) — raw IPs are never stored. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=
